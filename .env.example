# Copy to .env and fill in the two keys. Nothing else is required.

# Jev (TypeSafe AI) — https://typesafe.ai
TYPESAFE_API_KEY=apikey_...

# SenseLab — sign up / log in at https://amfs.sense-lab.ai, then create an API key
AMFS_API_KEY=amfs_...

# SenseLab API base. Leave as is unless you run your own server.
AMFS_HTTP_URL=https://amfs-login.sense-lab.ai

# Voice demo (voice/), optional. From your Vapi account (https://vapi.ai).
# VAPI_PUBLIC_KEY=your-vapi-public-key        # the browser uses it to start calls
# VAPI_PRIVATE_KEY=your-vapi-private-key      # the server uses it to create the assistant
# VAPI_WEBHOOK_SECRET=any-random-string       # sent by Vapi as x-vapi-secret, checked by the server
# VOICE_BUSINESS=voice/business.toml          # the business the voice agent answers for (copy and edit for yours)
# VOICE_STACK=realtime                        # realtime: OpenAI gpt-realtime-2 speech to speech (default); pipeline: Deepgram + GPT-4.1 + ElevenLabs
# VAPI_VOICE_ID=cedar                         # realtime: marin, cedar, alloy, echo, shimmer; pipeline: any ElevenLabs voice (VAPI_VOICE_PROVIDER=11labs)
# VOICE_TOOL_MIN_MS=1500                      # realtime only: hold tool answers this long so they land after the model's turn (see voice/README.md)
