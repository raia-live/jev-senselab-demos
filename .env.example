# Copy to .env and fill in the two keys. Nothing else is required.

# Jev (TypeSafe AI) — https://typesafe.ai
TYPESAFE_API_KEY=apikey_...

# SenseLab — sign up / log in at https://amfs.sense-lab.ai, then create an API key
AMFS_API_KEY=amfs_...

# SenseLab API base. Leave as is unless you run your own server.
AMFS_HTTP_URL=https://amfs-login.sense-lab.ai
